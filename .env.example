# Plantilla de variables de entorno para BiciSafe (backend).
#
# IMPORTANTE: Spring Boot NO lee este archivo automáticamente. Es una referencia
# para saber qué variables acepta la aplicación. Úsalo de una de estas formas:
#   - Linux/macOS:   export $(grep -v '^#' .env | xargs)   (o define cada una)
#   - Windows CMD:   set DB_URL=jdbc:postgresql://localhost:5432/bicisafe
#   - PowerShell:    $env:DB_URL = "jdbc:postgresql://localhost:5432/bicisafe"
#   - VS Code:       launch.json -> "envFile": "${workspaceFolder}/.env"
#   - Docker Compose: copia este archivo a .env en la raíz
#
# No subas tu .env real al repositorio (ya está en .gitignore).

# --- Conexión a la base de datos existente (PostgreSQL + PostGIS) ---
DB_URL=jdbc:postgresql://localhost:5432/bicisafe
DB_USERNAME=user
DB_PASSWORD=1234

# --- Perfil de Spring Boot: dev | prod ---
SPRING_PROFILES_ACTIVE=dev

# --- Seguridad (JWT). En producción, mínimo 32 bytes ---
JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-bytes
JWT_EXPIRATION_MINUTES=60

# --- CORS (origen del frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# --- URL pública del frontend (para enlaces de correos, ej. verificación) ---
FRONTEND_URL=http://localhost:3000

# --- OpenRouteService ---
ORS_BASE_URL=https://api.openrouteservice.org
ORS_API_KEY=eyJvcmciOiI1YjNjZTM1OTc4NTExMTAwMDFjZjYyNDgiLCJpZCI6ImMzOGU3ZWI5ZTVhYzRlZWQ5MDkzZmNiMTQxNzBlOTM5IiwiaCI6Im11cm11cjY0In0=

# --- Nominatim (búsqueda de lugares; la política pide User-Agent propio) ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --- Correo (Gmail SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=diplooplay@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=diplooplay@gmail.com
